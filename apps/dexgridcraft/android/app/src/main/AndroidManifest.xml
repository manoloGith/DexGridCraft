<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- wgpu draws with Vulkan or OpenGL ES 3; glow (the fallback) needs OpenGL ES 3 too. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- A mouse and a keyboard are what DeX is for, but the app also starts without them. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DexGridCraft"
        android:resizeableActivity="true">

        <!-- Samsung DeX: keep the process when the window moves between the phone and the monitor
             or the density changes (otherwise DeX restarts the app and the document is lost). -->
        <meta-data android:name="com.samsung.android.keepalive.density" android:value="true" />
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="true" />

        <!-- GameActivity subclass: winit receives every resize, density, keyboard and theme
             change as an event, so none of them may recreate the activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection|colorMode|touchscreen|mcc|mnc|fontWeightAdjustment">

            <meta-data android:name="android.app.lib_name" android:value="dexgridcraft" />

            <!-- A desktop-sized window when DeX or desktop windowing opens it in a freeform window. -->
            <layout
                android:defaultWidth="1280dp"
                android:defaultHeight="800dp"
                android:gravity="center"
                android:minWidth="720dp"
                android:minHeight="480dp" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" for workbooks (Excel, OpenDocument, CSV) from files apps, browsers and mail. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel.sheet.macroEnabled.12" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.ms-excel.sheet.binary.macroEnabled.12" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/tab-separated-values" />
            </intent-filter>

            <!-- "Share" one or several workbooks to the app: each opens in its own window. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel.sheet.macroEnabled.12" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.ms-excel.sheet.binary.macroEnabled.12" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/tab-separated-values" />
            </intent-filter>

            <!-- DexFiles (manoloGith/DexFiles, docs/apps-dex.md) finds the Dex apps by this action
                 and makes this one its default app for the extensions below; it then opens the
                 files with VIEW (a content:// with read and write permission), as above. The
                 spreadsheet formats GridCraft opens (gridcraft-engine's FileKind); .txt, .json,
                 .html and .htm, which it also reads, are left to text editors and browsers. -->
            <intent-filter>
                <action android:name="io.github.dexfiles.action.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="io.github.dexfiles.extensions"
                android:value="xlsx, xlsm, xltx, xltm, xls, xlt, xlsb, ods, csv, tsv, tab, slk, scjson" />
        </activity>

        <!-- RestartActivity and the clipboard's FileProvider come from craft-activity's manifest. -->
    </application>
</manifest>
